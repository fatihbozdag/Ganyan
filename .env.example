DATABASE_URL=postgresql+psycopg://ganyan:ganyan@localhost:5432/ganyan
TJK_BASE_URL=https://www.tjk.org
SCRAPE_DELAY=2.0
LOG_LEVEL=INFO
FLASK_PORT=5003
FLASK_DEBUG=false

# Local browser writes require a session CSRF token. Remote writes use a bearer token.
FLASK_HOST=127.0.0.1
# Set a stable random value for multi-process/restarted browser sessions.
SECRET_KEY=
# Set for remote API writes; send Authorization: Bearer <value>.
MUTATION_TOKEN=
# Optional absolute directory containing approved model artifacts and active.json.
# GANYAN_MODEL_DIR=/absolute/path/to/models
# Disable background work for development, tests, or additional web workers.
GANYAN_SKIP_SCHEDULER=1
GANYAN_SKIP_LAUNCH_REFRESH=1
